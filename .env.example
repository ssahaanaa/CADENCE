# Copy this to .env and fill in before running `docker compose up`.

# Shared password required to view/use the console. Leave blank while
# testing locally; set it before this is reachable outside your machine.
APP_PASSWORD=

# Optional: automatic scans on a schedule, standard 5-field cron.
# Leave blank to only scan when someone clicks "Run scan".
# Example: "0 3 * * *"  ->  every day at 03:00 server time.
SCAN_CRON=
